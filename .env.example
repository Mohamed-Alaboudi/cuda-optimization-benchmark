# Names only; no values here. Copy to .env (never commit it) or export these in your shell.
# trials (model calls, made from your own machine):
OPENAI_API_KEY=
KIMI_API_KEY=
# The Claude row runs through Anthropic's API; provider anthropic_api in models.json.
ANTHROPIC_API_KEY=
# pod (RunPod GPU, optional; any Linux machine with an NVIDIA GPU, nvcc and PyTorch also works):
RUNPOD_API_KEY=
# grade and regrade need no keys.
